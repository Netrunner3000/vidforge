# Copy to .env and fill in. Never commit .env.

# Required — script writing, narration (TTS), images, transcription.
OPENAI_API_KEY=sk-...

# Optional — only if script.provider is set to "anthropic" in config.yaml.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only if visuals.source is set to "pexels".
PEXELS_API_KEY=

# Optional — the trend Scanner (`main.py scan` / the Scanner tab).
# A plain Google Cloud API key, NOT the OAuth client used for uploading:
#   1. Enable "YouTube Data API v3" at
#      https://console.cloud.google.com/apis/library/youtube.googleapis.com
#   2. Credentials -> Create credentials -> API key
YOUTUBE_API_KEY=

# Optional — where rendered videos land. Defaults to <project>/output.
VIDFORGE_OUTPUT_DIR=

# Optional — YouTube OAuth client secret file (downloaded from Google Cloud
# Console, "OAuth client ID" of type "Desktop app"). Defaults to
# <project>/.secrets/client_secret.json
VIDFORGE_YT_CLIENT_SECRET=
